# AML Studio — Environment configuration example
# Copy this file to .env.local and fill in the values as needed.

# ─── Backend URL (optional) ────────────────────────────────────────────────
# When set, GitHub and Bitbucket connections are enabled.
# When absent, only local and public repository import is available.
# VITE_BACKEND_URL=https://api.your-aml-backend.example.com
